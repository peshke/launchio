<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/launchioFocusBg" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="?attr/launchioRing" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/launchioRaised" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/launchioAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/launchioRaised" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
