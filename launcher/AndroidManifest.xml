<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.peshke.launchio"
    android:versionCode="101"
    android:versionName="0.1.1">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Continue watching row: read other apps' Watch Next entries, and fetch their artwork. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted over ADB: lets Launchio restart its power service when the TV leaves it stopped. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
    </queries>

    <application
        android:label="Launchio"
        android:icon="@drawable/launchio_icon"
        android:banner="@drawable/launchio_banner"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Restart and standby from the Settings menu (accessibility, enabled over ADB). -->
        <service
            android:name=".PowerService"
            android:exported="true"
            android:label="@string/power_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/power_service" />
        </service>

        <!-- Lets the launcher see what music apps are playing (notification access, granted over ADB). -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="Launchio: now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
